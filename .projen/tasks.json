{
  "manifestVersion": 3,
  "env": {
    "PATH": "$(echo .venv/bin:$PATH)",
    "VIRTUAL_ENV": ".venv"
  },
  "tasks": {
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "default"
        },
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "compile": {
      "name": "compile",
      "description": "Only compile",
      "steps": [
        {
          "execArgs": [
            "bun",
            "node_modules/pacwich/bin/cli.js",
            "run",
            "compile",
            "--dep-order",
            "--parallel=false",
            "--output-style=plain"
          ]
        }
      ]
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "execArgs": [
            "node",
            ".projenrc.ts"
          ]
        }
      ]
    },
    "install": {
      "name": "install",
      "description": "Install dependencies and update lockfile",
      "steps": [
        {
          "exec": "bun install"
        },
        {
          "execArgs": [
            "uv",
            "sync",
            "--all-packages",
            "--all-groups"
          ]
        }
      ]
    },
    "install:ci": {
      "name": "install:ci",
      "description": "Install dependencies with frozen lockfile",
      "steps": [
        {
          "exec": "bun install --frozen-lockfile"
        },
        {
          "execArgs": [
            "uv",
            "sync",
            "--all-packages",
            "--all-groups",
            "--locked"
          ]
        }
      ]
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package",
      "steps": [
        {
          "execArgs": [
            "bun",
            "run",
            "--filter",
            "./packages/js/*",
            "pack:release"
          ]
        },
        {
          "execArgs": [
            "uv",
            "build",
            "--package",
            "pynect-worker",
            "--out-dir",
            "dist/packages/python",
            "--no-sources"
          ]
        }
      ]
    },
    "post-compile": {
      "name": "post-compile",
      "description": "Runs after successful compilation",
      "steps": [
        {
          "spawn": "typecheck:workspaces"
        }
      ]
    },
    "pre-compile": {
      "name": "pre-compile",
      "description": "Prepare the project for compilation"
    },
    "publish:release": {
      "name": "publish:release",
      "description": "Publish the generated archives using npm trusted publishing.",
      "steps": [
        {
          "execArgs": [
            "bun",
            "node_modules/pacwich/bin/cli.js",
            "run",
            "publish:release",
            "--dep-order",
            "--parallel=false",
            "--output-style=plain"
          ]
        }
      ]
    },
    "release": {
      "name": "release",
      "description": "Verify, version, tag, and atomically push the shared release.",
      "steps": [
        {
          "execArgs": [
            "bun",
            "scripts/release.ts"
          ],
          "receiveArgs": true
        }
      ]
    },
    "release:check": {
      "name": "release:check",
      "description": "Validate a release tag and registry availability.",
      "steps": [
        {
          "execArgs": [
            "bun",
            "scripts/release-check.ts"
          ],
          "receiveArgs": true
        }
      ]
    },
    "test": {
      "name": "test",
      "description": "Run tests",
      "steps": [
        {
          "execArgs": [
            "bun",
            "test",
            "tests/monorepo.test.ts",
            "tests/release-lib.test.ts"
          ]
        },
        {
          "execArgs": [
            "bun",
            "run",
            "--filter",
            "./packages/js/*",
            "test"
          ]
        },
        {
          "execArgs": [
            "uv",
            "run",
            "--locked",
            "--package",
            "pynect-worker",
            "python",
            "-m",
            "pytest"
          ],
          "cwd": "packages/py/pynect-worker"
        }
      ]
    },
    "typecheck": {
      "name": "typecheck",
      "description": "Build workspace dependencies, then type-check the monorepo.",
      "steps": [
        {
          "spawn": "compile"
        },
        {
          "spawn": "typecheck:workspaces"
        }
      ]
    },
    "typecheck:workspaces": {
      "name": "typecheck:workspaces",
      "description": "Type-check Projen, shared scripts, and built workspaces.",
      "steps": [
        {
          "execArgs": [
            "bun",
            "node_modules/pacwich/bin/cli.js",
            "verify",
            "--strict"
          ]
        },
        {
          "execArgs": [
            "bun",
            "x",
            "tsc",
            "--noEmit",
            "-p",
            "tsconfig.json"
          ]
        },
        {
          "execArgs": [
            "bun",
            "run",
            "--filter",
            "./packages/js/*",
            "typecheck"
          ]
        },
        {
          "execArgs": [
            "uv",
            "run",
            "--locked",
            "--package",
            "pynect-worker",
            "ruff",
            "check",
            "src",
            "tests"
          ],
          "cwd": "packages/py/pynect-worker"
        },
        {
          "execArgs": [
            "uv",
            "run",
            "--locked",
            "--package",
            "pynect-worker",
            "ruff",
            "format",
            "--check",
            "src",
            "tests"
          ],
          "cwd": "packages/py/pynect-worker"
        },
        {
          "execArgs": [
            "uv",
            "run",
            "--locked",
            "--package",
            "pynect-worker-example",
            "ruff",
            "check",
            "src"
          ],
          "cwd": "packages/py/pynect-worker-example"
        },
        {
          "execArgs": [
            "uv",
            "run",
            "--locked",
            "--package",
            "pynect-worker-example",
            "ruff",
            "format",
            "--check",
            "src"
          ],
          "cwd": "packages/py/pynect-worker-example"
        }
      ]
    },
    "verify": {
      "name": "verify",
      "description": "Synthesize, build, type-check, test, and pack all workspaces.",
      "steps": [
        {
          "spawn": "build"
        }
      ]
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"bunx projen\"."
}
