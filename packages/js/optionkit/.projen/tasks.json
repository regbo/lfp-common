{
  "manifestVersion": 3,
  "env": {
    "PATH": "$(bun --eval \"console.log(process.env.PATH)\")"
  },
  "tasks": {
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "compile": {
      "name": "compile",
      "description": "Only compile",
      "steps": [
        {
          "execArgs": [
            "bun",
            "scripts/build.ts"
          ]
        }
      ]
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "exec": "bunx projen default",
          "cwd": "../../.."
        }
      ]
    },
    "install": {
      "name": "install",
      "description": "Install project dependencies and update lockfile (non-frozen)",
      "steps": [
        {
          "exec": "bun install"
        }
      ]
    },
    "install:ci": {
      "name": "install:ci",
      "description": "Install project dependencies using frozen lockfile",
      "steps": [
        {
          "exec": "bun install --frozen-lockfile"
        }
      ]
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package"
    },
    "post-compile": {
      "name": "post-compile",
      "description": "Runs after successful compilation"
    },
    "pre-compile": {
      "name": "pre-compile",
      "description": "Prepare the project for compilation"
    },
    "test": {
      "name": "test",
      "description": "Run tests",
      "steps": [
        {
          "execArgs": [
            "bun",
            "scripts/generate-catalog.ts"
          ]
        },
        {
          "execArgs": [
            "bun",
            "test"
          ]
        }
      ]
    },
    "test:packed": {
      "name": "test:packed",
      "description": "Smoke-test the packed package in an isolated consumer.",
      "steps": [
        {
          "execArgs": [
            "bun",
            "scripts/test-packed.ts"
          ]
        }
      ]
    },
    "typecheck": {
      "name": "typecheck",
      "description": "Type-check optionkit.",
      "steps": [
        {
          "execArgs": [
            "bun",
            "scripts/generate-catalog.ts"
          ]
        },
        {
          "execArgs": [
            "tsc",
            "--noEmit",
            "-p",
            "tsconfig.json"
          ]
        },
        {
          "execArgs": [
            "tsc",
            "--noEmit",
            "-p",
            "scripts/tsconfig.json"
          ]
        },
        {
          "execArgs": [
            "tsc",
            "--noEmit",
            "-p",
            "tests/tsconfig.json"
          ]
        }
      ]
    },
    "verify": {
      "name": "verify",
      "description": "Build, type-check, and test optionkit.",
      "steps": [
        {
          "spawn": "compile"
        },
        {
          "spawn": "typecheck"
        },
        {
          "spawn": "test"
        }
      ]
    },
    "watch": {
      "name": "watch",
      "description": "Watch & compile in the background",
      "steps": [
        {
          "execArgs": [
            "tsc",
            "--build",
            "-w"
          ]
        }
      ]
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.js and run \"bunx projen\"."
}
