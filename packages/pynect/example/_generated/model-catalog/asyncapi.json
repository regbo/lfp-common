          "context_window"
        ],
        "title": "Model",
        "type": "object"
      },
      "ModelFilters": {
        "properties": {
          "query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Query"
          },
          "provider": {
            "anyOf": [
              {
                "enum": [
                  "anthropic",
                  "openai"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Provider"
          }
        },
        "title": "ModelFilters",
        "type": "object"
      },
      "ProblemDetails": {
        "description": "An RFC 9457 problem details object, the payload of an error frame. See https://python.chanx.dev/en/latest/protocol.html#protocol-errors",
        "properties": {
          "type": {
            "description": "A URI reference that identifies the problem type.",
            "format": "uri-reference",
            "type": "string"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type.",
            "type": "string"
          },
          "status": {
            "description": "The HTTP status code generated by the origin server for this occurrence of the problem.",
            "maximum": 599,
            "minimum": 100,
            "type": "integer"
          },
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "type": "string"
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem. It may or may not yield further information if dereferenced.",
            "format": "uri-reference",
            "type": "string"
          },
          "errors": {
            "description": "The validation failures, when type is validation-failed.",
            "items": {
              "$ref": "#/components/schemas/ValidationFailure"
            },
            "type": "array"
          }
        },
        "required": [
          "type",
          "title",
          "detail"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "ValidationFailure": {
        "description": "One validation failure, shaped like RFC 9457's validation example.",
        "properties": {
          "keyword": {
            "description": "The JSON Schema keyword that failed, or custom.",
            "type": "string"
          },
          "pointer": {
            "description": "A JSON Pointer to the failing value in the frame; for required, the object lacking the member.",
            "type": "string"
          },
          "detail": {
            "description": "A human-readable message.",
            "type": "string"
          },
          "property": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "description": "For required only: the missing member."
          }
        },
        "required": [
          "keyword",
          "pointer",
          "detail"
        ],
        "title": "ValidationFailure",
        "type": "object"
      }
