{
  "manifestVersion": 3,
  "env": {
    "PATH": "$(bun --eval \"console.log(process.env.PATH)\")"
  },
  "tasks": {
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "check:python": {
      "name": "check:python",
      "steps": [
        {
          "execArgs": [
            "uv",
            "run",
            "--locked",
            "ruff",
            "check",
            "src/py",
            "tests/py"
          ]
        }
      ]
    },
    "compile": {
      "name": "compile",
      "description": "Only compile",
      "steps": [
        {
          "execArgs": [
            "bun",
            "src/js/generate-schema.ts"
          ]
        },
        {
          "execArgs": [
            "bun",
            "src/js/build.js"
          ]
        }
      ]
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "exec": "bunx projen default",
          "cwd": "../.."
        }
      ]
    },
    "format:python": {
      "name": "format:python",
      "steps": [
        {
          "execArgs": [
            "uv",
            "run",
            "--locked",
            "ruff",
            "format",
            "src/py",
            "tests/py"
          ]
        }
      ]
    },
    "format:python:check": {
      "name": "format:python:check",
      "steps": [
        {
          "execArgs": [
            "uv",
            "run",
            "--locked",
            "ruff",
            "format",
            "--check",
            "src/py",
            "tests/py"
          ]
        }
      ]
    },
    "install": {
      "name": "install",
      "description": "Install project dependencies and update lockfile (non-frozen)",
      "steps": [
        {
          "exec": "bun install"
        }
      ]
    },
    "install:ci": {
      "name": "install:ci",
      "description": "Install project dependencies using frozen lockfile",
      "steps": [
        {
          "exec": "bun install --frozen-lockfile"
        }
      ]
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package"
    },
    "post-compile": {
      "name": "post-compile",
      "description": "Runs after successful compilation"
    },
    "pre-compile": {
      "name": "pre-compile",
      "description": "Prepare the project for compilation"
    },
    "test": {
      "name": "test",
      "description": "Run tests",
      "steps": [
        {
          "execArgs": [
            "bun",
            "test"
          ]
        },
        {
          "execArgs": [
            "uv",
            "run",
            "--locked",
            "pytest"
          ]
        }
      ]
    },
    "test:smoke": {
      "name": "test:smoke",
      "description": "Run opt-in Pynect I/O and startup smoke benchmarks.",
      "steps": [
        {
          "execArgs": [
            "bun",
            "test",
            "./tests/io.smoke.ts"
          ]
        }
      ]
    },
    "typecheck": {
      "name": "typecheck",
      "description": "Type-check pynect.",
      "steps": [
        {
          "execArgs": [
            "tsc",
            "--noEmit",
            "-p",
            "tsconfig.json"
          ]
        },
        {
          "execArgs": [
            "tsc",
            "--noEmit",
            "-p",
            "tests/tsconfig.json"
          ]
        },
        {
          "execArgs": [
            "bun",
            "src/js/generate-schema.ts",
            "--check"
          ]
        },
        {
          "execArgs": [
            "uv",
            "run",
            "--locked",
            "ruff",
            "check",
            "src/py",
            "tests/py"
          ]
        },
        {
          "execArgs": [
            "uv",
            "run",
            "--locked",
            "ruff",
            "format",
            "--check",
            "src/py",
            "tests/py"
          ]
        }
      ]
    },
    "verify": {
      "name": "verify",
      "description": "Build, type-check, and test pynect.",
      "steps": [
        {
          "spawn": "compile"
        },
        {
          "spawn": "typecheck"
        },
        {
          "spawn": "test"
        }
      ]
    },
    "watch": {
      "name": "watch",
      "description": "Watch & compile in the background",
      "steps": [
        {
          "execArgs": [
            "tsc",
            "--build",
            "-w"
          ]
        }
      ]
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.js and run \"bunx projen\"."
}
