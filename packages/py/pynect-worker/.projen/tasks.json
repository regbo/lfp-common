{
  "manifestVersion": 3,
  "tasks": {
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "check": {
      "name": "check",
      "steps": [
        {
          "execArgs": [
            "uv",
            "run",
            "--locked",
            "ruff",
            "check",
            "src",
            "tests"
          ]
        }
      ]
    },
    "compile": {
      "name": "compile",
      "description": "Only compile"
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "exec": "npx projen default",
          "cwd": "../../.."
        }
      ]
    },
    "format": {
      "name": "format",
      "steps": [
        {
          "execArgs": [
            "uv",
            "run",
            "--locked",
            "ruff",
            "format",
            "src",
            "tests"
          ]
        }
      ]
    },
    "format:check": {
      "name": "format:check",
      "steps": [
        {
          "execArgs": [
            "uv",
            "run",
            "--locked",
            "ruff",
            "format",
            "--check",
            "src",
            "tests"
          ]
        }
      ]
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package"
    },
    "post-compile": {
      "name": "post-compile",
      "description": "Runs after successful compilation"
    },
    "pre-compile": {
      "name": "pre-compile",
      "description": "Prepare the project for compilation"
    },
    "test": {
      "name": "test",
      "description": "Run tests",
      "steps": [
        {
          "execArgs": [
            "uv",
            "run",
            "--locked",
            "python",
            "-m",
            "pytest"
          ]
        }
      ]
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.js and run \"npx projen\"."
}
