flowchart TD
    A["Create pyenv with explicit runtime inputs"] --> B["Validate passed requirements files"]
    B --> C["Create temporary file for passed dependency specifiers"]
    C --> F["uv pip compile only those explicit inputs"]
    F --> G{"Resolution succeeds?"}
    G -->|No| H["Stop; existing venvs and input files stay unchanged"]
    G -->|Yes| I["Hash interpreter and exact resolution"]
    I --> J{"Matching complete venv exists?"}
    J -->|Yes| K["Reuse the hashed venv"]
    J -->|No| L["Create private venv and install the resolution"]
    L --> M["Publish venv metadata last"]
    K --> N["Delete temporary files"]
    M --> N
