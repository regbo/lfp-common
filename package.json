{
  "name": "pyfig",
  "version": "0.6.1",
  "description": "Prepare uv-first Python runtime environments without editing project files.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "bin": {
    "pyfig": "dist/cli.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "test": "bun test",
    "test:zero-python": "bun run scripts/smoke-zero-python.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "verify": "bun run typecheck && bun test",
    "release": "bun run scripts/release.ts",
    "release:check": "bun run scripts/check-release.ts",
    "release:audit": "bun run scripts/audit-package.ts",
    "prepack": "bun run scripts/prepack.ts"
  },
  "keywords": [
    "python",
    "uv",
    "bootstrap",
    "bun",
    "cli"
  ],
  "author": "Reggie Bowser",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regbo/pyfig.git"
  },
  "bugs": {
    "url": "https://github.com/regbo/pyfig/issues"
  },
  "homepage": "https://github.com/regbo/pyfig#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "bun@1.4.4",
  "sideEffects": false,
  "engines": {
    "node": "^22.11.0 || >=24.10.0 <=26.x",
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "@renovatebot/pep440": "^5.0.1",
    "commander": "^14.0.3",
    "env-paths": "^4.0.0",
    "fflate": "^0.8.3",
    "loqkit": ">=0.0.5 <0.1.0",
    "tar": "^7.4.3",
    "undici": "^7.30.1",
    "which": "^6.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "@types/which": "^3.0.4",
    "semver": "^7.8.5",
    "typescript": "^7.0.2"
  }
}
