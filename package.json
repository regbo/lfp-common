{
  "name": "optionkit",
  "version": "0.0.1",
  "description": "Turn Zod configuration schemas into zero-setup Fireargs options.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun run generate && tsc -p tsconfig.json",
    "generate": "bun run scripts/generate-cli-dependencies.ts",
    "test": "bun run generate && bun test",
    "test:packed": "bun run build && bun run scripts/test-packed.ts",
    "typecheck": "bun run generate && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json",
    "verify": "bun run typecheck && bun test && bun run build",
    "prepack": "bun run verify"
  },
  "keywords": [
    "args",
    "cli",
    "config",
    "environment",
    "fireargs",
    "zod"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/regbo/optionkit.git"
  },
  "bugs": {
    "url": "https://github.com/regbo/optionkit/issues"
  },
  "homepage": "https://github.com/regbo/optionkit#readme",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@antfu/install-pkg": "^2.1.0"
  },
  "peerDependencies": {
    "fireargs": "^0.6.2",
    "zod": "^4.6.7"
  },
  "peerDependenciesMeta": {
    "fireargs": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "clean-stack": "^7.0.0",
    "fireargs": "^0.6.2",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "packageManager": "bun@1.4.4",
  "publishConfig": {
    "access": "public"
  }
}
